# Host port published by docker-compose (Cloudflare Tunnel → http://127.0.0.1:$PORT)
PORT=8080

# Public site URL (informational; shown in /api/live/health)
PUBLIC_URL=https://dj.sagirosenthal.com

SHOW_SEED=dj-drosophila
# SHOW_START_MS=

# Optional: protects /api/admin/* if you add operator tools later
# Header only: X-Admin-Token (query ?token= is rejected)
# ADMIN_TOKEN=change-me-long-random

# Cap concurrent SSE HUD listeners (503 when full)
# MAX_SSE_CLIENTS=200

# DJ mind style lane: psy-peak | stadium-hype | bass-blender
# DJ_STYLE=psy-peak

# Optional Icecast output (HLS always runs). Leave ICECAST_HOST empty to skip.
# ICECAST_HOST=
# ICECAST_PORT=8000
# ICECAST_PASSWORD=
# ICECAST_MOUNT=/drosophila
# ICECAST_USER=source
